{
  "name": "clearmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Manage all your bookmarks and browser extensions from one place.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs",
    "test": "vitest run",
    "prepare": "husky",
    "icons": "node scripts/generate-icons.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.34.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^8.3.5",
    "vitest": "^1.6.0"
  }
}
